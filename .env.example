# ==============================================================================
# 365 — Unified Environment Configuration
# "One song. Every day."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spotify Web API (Music Catalog Provider)
# Obtain via Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# 2. Firebase Configuration (Auth, Firestore, Cloud Functions, FCM)
# Obtain via Firebase Project Settings: https://console.firebase.google.com/
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyFor365App
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ritual-365.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ritual-365
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ritual-365.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 3. Google Sign-In (OAuth Client IDs)
# Required for non-guest submissions
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-abcdef.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-iosdef.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789012-androiddef.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Admin Dashboard Web Client
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyFor365App
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ritual-365.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ritual-365
ADMIN_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "ritual-365"}'

# ------------------------------------------------------------------------------
# 5. Ritual Release Parameters (Defaults)
# ------------------------------------------------------------------------------
DEFAULT_RELEASE_TIME="19:00"
DEFAULT_RELEASE_TIMEZONE="Asia/Kolkata"
