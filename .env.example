# ==============================================================================
# 365 — Unified Environment Configuration
# "One song. Every day."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, RPC Functions) — 100% Free Tier ($0 Cost)
# Obtain via Supabase Project Settings -> API: https://supabase.com/dashboard
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 2. Spotify Web API (Music Catalog Provider — Free Developer Tier)
# Obtain via Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# 3. Google Sign-In (OAuth Client IDs for Google Auth)
# Required for non-guest submissions
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Ritual Release Parameters (Defaults)
# ------------------------------------------------------------------------------
DEFAULT_RELEASE_TIME="19:00"
DEFAULT_RELEASE_TIMEZONE="Asia/Kolkata"
